/* ======================================== */
/* BabysStyle.uss — BabysScene              */
/* ======================================== */

/* --- Header area --- */
.babys-header-area {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
}

/* --- Back button (round pastel circle, top-left) --- */
.babys-back-btn {
    position: absolute;
    left: 40px;
    top: 12px;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background-color: rgba(255, 183, 197, 0.25);
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    font-size: 38px;
    color: white;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.babys-back-btn:active {
    scale: 0.90 0.90;
    background-color: rgba(255, 183, 197, 0.45);
}

/* --- Title / Subtitle (center-aligned) --- */
.babys-title {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(93, 64, 55);
    letter-spacing: 2px;
    align-self: center;
}

.babys-subtitle {
    font-size: 26px;
    -unity-text-align: middle-center;
    color: rgb(130, 110, 90);
    margin-top: 4px;
    margin-bottom: 16px;
    align-self: center;
}

/* --- Slot card (auto height, generous padding) --- */
.slot-card {
    width: 980px;
    border-radius: 48px;
    background-color: rgba(255, 253, 249, 0.92);
    align-self: center;
    margin-bottom: 24px;
    flex-direction: row;
    align-items: center;
    padding: 28px 32px;
    border-width: 2px;
    border-color: rgba(255, 183, 197, 0.25);
    transition-property: scale;
    transition-duration: 0.08s;
}

.slot-card:active {
    scale: 0.98 0.98;
}

.slot-card-empty {
    width: 980px;
    height: 80px;
    border-radius: 48px;
    background-color: rgb(240, 240, 243);
    align-self: center;
    margin-bottom: 24px;
    align-items: center;
    justify-content: center;
}

.slot-empty-label {
    font-size: 24px;
    color: rgb(166, 166, 173);
    -unity-text-align: middle-center;
}

/* --- Baby face circle --- */
.baby-circle-border {
    width: 148px;
    height: 148px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    margin-right: 24px;
    flex-shrink: 0;
}

.baby-circle-mask {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-width: 0;
    padding: 0;
}

.baby-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Camera icon overlay --- */
.cam-icon {
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(115, 115, 128, 0.8);
    align-items: center;
    justify-content: center;
}

.cam-icon-text {
    font-size: 18px;
    color: white;
    -unity-text-align: middle-center;
}

/* --- Info section (center, flex-grow) --- */
.slot-info-section {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.baby-name-text {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(93, 64, 55);
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.baby-sub-info {
    font-size: 22px;
    color: rgb(140, 140, 153);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 8px;
}

/* --- Stats + story row --- */
.stats-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 12px;
}

.stat-pill {
    border-radius: 17px;
    height: 36px;
    background-color: rgba(247, 231, 206, 0.6);
    padding-left: 10px;
    padding-right: 10px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    margin-bottom: 4px;
}

.stat-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(77, 77, 89);
}

/* --- Omoide (story) pill inside stats row --- */
.omoide-btn {
    border-radius: 17px;
    height: 36px;
    background-color: rgba(255, 183, 197, 0.20);
    padding-left: 10px;
    padding-right: 10px;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    border-width: 0;
    font-size: 16px;
    color: rgb(160, 110, 120);
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.omoide-btn:active {
    scale: 0.93 0.93;
    background-color: rgba(255, 183, 197, 0.40);
}

/* --- Badges --- */
.now-badge {
    position: absolute;
    right: 24px;
    top: 20px;
    border-radius: 16px;
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(77, 140, 255);
    align-items: center;
    justify-content: center;
}

.god-badge {
    position: absolute;
    right: 24px;
    top: 20px;
    border-radius: 20px;
    height: 40px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgb(212, 175, 55);
    border-width: 2px;
    border-color: rgba(180, 140, 20, 0.5);
    align-items: center;
    justify-content: center;
}

.god-badge-shadow {
    position: absolute;
    right: 22px;
    top: 24px;
    width: 92px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(180, 140, 20, 0.15);
}

.badge-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

/* --- Story detail panel --- */
.story-detail-card {
    width: 920px;
    background-color: rgba(20, 15, 36, 0.97);
    border-radius: 40px;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 20px;
}

.story-detail-title {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 107, 179);
}

.story-detail-parents {
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(179, 153, 204);
    margin-top: 5px;
    margin-bottom: 15px;
}

.story-text {
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(230, 225, 243);
    white-space: normal;
    padding-left: 40px;
    padding-right: 40px;
}

.story-close-btn {
    width: 280px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(140, 89, 166);
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.story-close-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(115, 71, 140);
}
