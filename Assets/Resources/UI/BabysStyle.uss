/* ======================================== */
/* BabysStyle.uss — BabysScene              */
/* ======================================== */

/* --- Header --- */
.babys-header {
    flex-direction: row;
    width: 100%;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
}

.babys-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(38, 38, 46);
    flex-grow: 1;
}

.babys-subtitle {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgb(140, 140, 153);
    margin-bottom: 10px;
}

/* --- Info button (circle) --- */
.info-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold-and-italic;
    color: rgb(115, 115, 128);
    transition-property: scale;
    transition-duration: 0.08s;
}

.info-btn:active {
    scale: 0.95 0.95;
}

/* --- Slot card --- */
.slot-card {
    width: 980px;
    border-radius: 32px;
    background-color: white;
    align-self: center;
    margin-bottom: 24px;
    flex-direction: row;
    padding: 20px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.slot-card:active {
    scale: 0.98 0.98;
}

.slot-card-empty {
    width: 980px;
    height: 80px;
    border-radius: 32px;
    background-color: rgb(240, 240, 243);
    align-self: center;
    margin-bottom: 24px;
    align-items: center;
    justify-content: center;
}

.slot-empty-label {
    font-size: 24px;
    color: rgb(166, 166, 173);
    -unity-text-align: middle-center;
}

/* --- Baby face circle --- */
.baby-circle-border {
    width: 148px;
    height: 148px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
    flex-shrink: 0;
}

.baby-circle-mask {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-width: 0;
    padding: 0;
}

.baby-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Camera icon overlay --- */
.cam-icon {
    position: absolute;
    right: 2px;
    bottom: 2px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(115, 115, 128, 0.8);
    align-items: center;
    justify-content: center;
}

.cam-icon-text {
    font-size: 18px;
    color: white;
    -unity-text-align: middle-center;
}

/* --- Info section (right side) --- */
.slot-info-section {
    flex-grow: 1;
    justify-content: center;
}

.baby-name-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(38, 38, 46);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.baby-sub-info {
    font-size: 22px;
    color: rgb(140, 140, 153);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 4px;
}

/* --- Stats row --- */
.stats-row {
    flex-direction: row;
    margin-top: 12px;
}

.stat-pill {
    border-radius: 17px;
    height: 34px;
    background-color: rgb(243, 243, 248);
    padding-left: 10px;
    padding-right: 10px;
    align-items: center;
    justify-content: center;
    margin-right: 8px;
}

.stat-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(77, 77, 89);
}

/* --- Badges --- */
.now-badge {
    position: absolute;
    right: 20px;
    top: 16px;
    border-radius: 16px;
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(77, 140, 255);
    align-items: center;
    justify-content: center;
}

.god-badge {
    position: absolute;
    right: 20px;
    top: 16px;
    border-radius: 16px;
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(217, 166, 33);
    align-items: center;
    justify-content: center;
}

.badge-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

/* --- Story select panel --- */
.story-select-card {
    width: 860px;
    background-color: white;
    border-radius: 32px;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 20px;
}

.story-select-title {
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(38, 38, 46);
    margin-bottom: 20px;
}

.story-slot-btn {
    width: 740px;
    height: 100px;
    border-radius: 32px;
    background-color: rgb(245, 245, 250);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.story-slot-btn:active {
    scale: 0.97 0.97;
    background-color: rgb(230, 230, 240);
}

.story-slot-text {
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(38, 38, 46);
    white-space: normal;
}

/* --- Story detail panel --- */
.story-detail-card {
    width: 920px;
    background-color: rgba(20, 15, 36, 0.97);
    border-radius: 32px;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 20px;
}

.story-detail-title {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 107, 179);
}

.story-detail-parents {
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(179, 153, 204);
    margin-top: 5px;
    margin-bottom: 15px;
}

.story-text {
    font-size: 32px;
    -unity-text-align: middle-center;
    color: rgb(230, 225, 243);
    white-space: normal;
    padding-left: 40px;
    padding-right: 40px;
}

.story-close-btn {
    width: 280px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(140, 89, 166);
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.story-close-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(115, 71, 140);
}
