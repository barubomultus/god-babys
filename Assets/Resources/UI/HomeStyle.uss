/* ======================================== */
/* HomeStyle.uss — HomeScene (flexbox)      */
/* ======================================== */

/* --- 全体レイアウト --- */
.home-root {
    flex-grow: 1;
    flex-direction: column;
}

/* --- 背景（柔らかいピーチピンク） --- */
.home-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 237, 230);
}

/* --- 上部プロフィールエリア --- */
.home-profile {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
}

/* --- Player icon area --- */
.home-icon-border {
    width: 176px;
    height: 176px;
    border-radius: 50%;
    background-color: rgb(255, 183, 197);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.home-icon-mask {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    background-color: white;
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.home-icon-mask:active {
    scale: 0.95 0.95;
}

.home-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.home-player-name {
    flex-shrink: 0;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(60, 40, 50);
    margin-top: 15px;
}

/* --- セパレーター --- */
.home-separator {
    height: 2px;
    width: 700px;
    background-color: rgba(255, 183, 197, 0.5);
    margin-top: 20px;
}

/* --- 中央エリア (こいみこし + ガチャ説明) --- */
.home-center {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.gacha-desc {
    flex-shrink: 0;
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(100, 75, 85);
    margin-top: 10px;
}

/* --- Koimikoshi image --- */
.koimikoshi-container {
    flex-shrink: 0;
    width: 1040px;
    height: 498px;
    overflow: hidden;
    border-radius: 48px;
    margin-top: 30px;
}

.koimikoshi-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- 下部ボタンエリア --- */
.home-buttons {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 20px;
}

/* --- ボタン行 --- */
.home-btn-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

/* --- Meet button (ピンク塗りつぶし) --- */
.meet-btn-border {
    width: 708px;
    height: 128px;
    border-radius: 64px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.meet-btn {
    width: 700px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(242, 78, 128);
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    border-width: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
    padding: 0;
}

.meet-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(220, 60, 110);
}

