/* ======================================== */
/* EnishiStyle.uss — EnishiScene            */
/* ======================================== */

.enishi-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(89, 51, 115);
    margin-bottom: 10px;
}

/* --- Grid item --- */
.grid-item {
    width: 280px;
    height: 320px;
    flex-shrink: 0;
    align-items: center;
    margin-bottom: 20px;
}

.grid-circle-border {
    width: 270px;
    height: 270px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: rgb(209, 209, 209);
    align-items: center;
    justify-content: center;
}

.grid-circle-mask {
    width: 264px;
    height: 264px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.grid-circle-mask:active {
    scale: 0.95 0.95;
}

.grid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.grid-image-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgb(217, 217, 217);
}

.grid-name {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgb(51, 51, 51);
    margin-top: 8px;
    width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- Section header --- */
.section-header {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(89, 51, 115);
    margin-top: 20px;
    margin-bottom: 5px;
    flex-shrink: 0;
    width: 100%;
}

.section-separator {
    width: 900px;
    height: 3px;
    flex-shrink: 0;
    background-color: rgba(140, 89, 166, 0.4);
    align-self: center;
    margin-bottom: 20px;
}

.empty-text {
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(128, 128, 128);
    margin-top: 10px;
    margin-bottom: 30px;
}

/* --- Detail panel --- */
.detail-panel {
    background-color: rgb(248, 243, 250);
    border-radius: 40px;
    width: 980px;
    align-self: center;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 20px;
}

.detail-image-border {
    width: 358px;
    height: 358px;
    border-radius: 50%;
    background-color: rgba(140, 89, 166, 0.5);
    align-items: center;
    justify-content: center;
}

.detail-image-mask {
    width: 350px;
    height: 350px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
}

.detail-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.detail-name {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(38, 38, 38);
    margin-top: 20px;
}

.detail-description {
    font-size: 36px;
    -unity-text-align: upper-left;
    color: rgb(64, 64, 64);
    white-space: normal;
    margin-top: 20px;
    padding-left: 40px;
    padding-right: 40px;
}

/* --- Grid container (column of rows) --- */
.enishi-grid {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
}

.enishi-grid-row {
    flex-direction: row;
    justify-content: center;
    width: 100%;
    height: 340px;
    flex-shrink: 0;
}

/* --- Album detail panel --- */
.album-panel {
    width: 1000px;
    align-self: center;
    background-color: rgb(245, 235, 218);
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(160, 130, 90, 0.4);
    padding-top: 40px;
    padding-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;
}

.album-content {
    flex-direction: row;
    align-items: flex-start;
}

.album-left {
    width: 420px;
    flex-shrink: 0;
    position: relative;
    align-items: center;
}

.polaroid-frame {
    background-color: rgb(255, 255, 255);
    padding-top: 16px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 50px;
    align-items: center;
}

.polaroid-inner {
    width: 308px;
    height: 308px;
    overflow: hidden;
}

.polaroid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.polaroid-caption {
    font-size: 26px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    color: rgb(80, 60, 40);
    margin-top: 8px;
    letter-spacing: 1px;
}

.corner-seal {
    position: absolute;
    width: 36px;
    height: 36px;
    background-color: rgba(180, 150, 90, 0.45);
    border-radius: 2px;
}

.album-right {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 20px;
    padding-right: 10px;
    justify-content: flex-start;
}

.album-name {
    font-size: 38px;
    -unity-font-style: bold-and-italic;
    color: rgb(80, 60, 40);
    letter-spacing: 1px;
    margin-bottom: 12px;
}

.album-divider {
    width: 100%;
    height: 2px;
    background-color: rgba(160, 130, 90, 0.5);
    margin-bottom: 16px;
}

.album-description {
    font-size: 30px;
    -unity-font-style: italic;
    color: rgb(80, 60, 40);
    white-space: normal;
    letter-spacing: 1px;
    -unity-paragraph-spacing: 12px;
    word-spacing: 2px;
}

.album-footer {
    align-items: center;
    margin-top: 30px;
}

.album-love-button {
    width: 600px;
    height: 100px;
    font-size: 38px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(198, 160, 80);
    border-radius: 50px;
    border-width: 0;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.album-love-button:active {
    scale: 0.96 0.96;
}

.album-close-button {
    width: 400px;
    height: 80px;
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(80, 60, 40);
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 40px;
    border-width: 2px;
    border-color: rgba(160, 130, 90, 0.5);
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.album-close-button:active {
    scale: 0.96 0.96;
}
