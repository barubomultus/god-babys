/* ======================================== */
/* EnishiStyle.uss — EnishiScene            */
/* ======================================== */

.enishi-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(89, 51, 115);
    margin-bottom: 10px;
}

/* --- Grid item --- */
.grid-item {
    width: 280px;
    align-items: center;
    margin-bottom: 20px;
}

.grid-circle-border {
    width: 286px;
    height: 286px;
    border-radius: 50%;
    background-color: rgb(209, 209, 209);
    align-items: center;
    justify-content: center;
}

.grid-circle-mask {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.grid-circle-mask:active {
    scale: 0.95 0.95;
}

.grid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.grid-image-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgb(217, 217, 217);
}

.grid-name {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: rgb(51, 51, 51);
    margin-top: 8px;
    width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* --- Section header --- */
.section-header {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(89, 51, 115);
    margin-top: 20px;
    margin-bottom: 5px;
    width: 100%;
}

.section-separator {
    width: 900px;
    height: 3px;
    background-color: rgba(140, 89, 166, 0.4);
    align-self: center;
    margin-bottom: 20px;
}

.empty-text {
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(128, 128, 128);
    margin-top: 10px;
    margin-bottom: 30px;
}

/* --- Detail panel --- */
.detail-panel {
    background-color: rgb(248, 243, 250);
    border-radius: 12px;
    width: 980px;
    align-self: center;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 20px;
}

.detail-image-border {
    width: 358px;
    height: 358px;
    border-radius: 50%;
    background-color: rgba(140, 89, 166, 0.5);
    align-items: center;
    justify-content: center;
}

.detail-image-mask {
    width: 350px;
    height: 350px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
}

.detail-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-name {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(38, 38, 38);
    margin-top: 20px;
}

.detail-description {
    font-size: 36px;
    -unity-text-align: upper-left;
    color: rgb(64, 64, 64);
    white-space: normal;
    margin-top: 20px;
    padding-left: 40px;
    padding-right: 40px;
}

/* --- Grid container --- */
.enishi-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
}
