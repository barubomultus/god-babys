/* ======================================== */
/* MapStyle.uss — MapScene UI overlay       */
/* ======================================== */

/* --- Game layer (tiles, player, overlays) --- */
.map-game-layer {
    position: absolute;
    overflow: visible;
}

/* --- Status bar (top) --- */
.map-status-bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 80px;
    background-color: var(--color-main);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-sub);
    padding-left: 15px;
    padding-right: 100px;
    padding-top: 5px;
    padding-bottom: 5px;
    justify-content: center;
}

.map-status-text {
    font-size: 28px;
    color: var(--color-black);
    white-space: normal;
}

/* --- Menu button (bottom-right, menu.png) --- */
.map-menu-btn {
    position: absolute;
    right: 24px;
    bottom: 24px;
    width: 160px;
    height: 160px;
    border-radius: 32px;
    background-color: transparent;
    align-items: center;
    justify-content: flex-end;
    border-width: 0;
    padding: 0;
    padding-bottom: 20px;
    transition-property: scale;
    transition-duration: 0.08s;
    -unity-background-scale-mode: scale-to-fit;
}

.map-menu-btn:active {
    scale: 0.93 0.93;
}

.map-menu-label {
    font-size: 40px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(0, 0, 0);
    letter-spacing: 8px;
}

/* --- Menu card --- */
.map-menu-card {
    width: 900px;
    border-radius: 48px;
    background-color: var(--color-main);
    align-items: center;
    padding-top: 40px;
    padding-bottom: 30px;
}

.map-menu-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.map-menu-item-btn {
    width: 780px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--color-white);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-black);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.map-menu-item-btn:active {
    scale: 0.95 0.95;
    background-color: var(--color-sub);
    color: var(--color-white);
}

/* --- Save panel --- */
.map-save-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-main);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.map-save-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-black);
    margin-bottom: 48px;
}

.map-save-slot {
    width: 860px;
    height: 120px;
    border-radius: 60px;
    align-items: center;
    justify-content: center;
    margin: 12px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 16px;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-black);
    transition-property: scale, background-color, color;
    transition-duration: 0.08s;
}

.map-save-slot:active {
    scale: 0.95 0.95;
    background-color: var(--color-sub);
    color: var(--color-white);
}

.map-save-slot-exists {
    background-color: var(--color-white);
}

.map-save-slot-empty {
    background-color: rgba(255, 255, 255, 0.5);
    border-color: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.4);
}

.map-save-close-btn {
    width: 500px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.12);
    align-self: center;
    align-items: center;
    justify-content: center;
    margin-top: 48px;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-black);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.map-save-close-btn:active {
    scale: 0.95 0.95;
    background-color: var(--color-sub);
    color: var(--color-white);
}

.map-save-confirm-btn {
    width: 600px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--color-sub);
    border-width: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-white);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.map-save-confirm-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(255, 183, 197, 0.8);
}

.map-save-cancel-btn {
    width: 500px;
    height: 100px;
    border-radius: 50px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.12);
    align-self: center;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-black);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.map-save-cancel-btn:active {
    scale: 0.95 0.95;
    background-color: var(--color-main);
}

/* --- Status detail panel --- */
.map-detail-panel {
    width: 900px;
    background-color: var(--color-main);
    border-radius: 48px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 36px 32px 32px 32px;
    align-items: center;
}

.map-detail-title {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-black);
    margin-bottom: 20px;
}

.map-detail-content {
    font-size: 30px;
    color: var(--color-black);
    white-space: normal;
    -unity-text-align: upper-left;
    width: 800px;
}

/* --- Inventory panel --- */
.map-inv-panel {
    width: 900px;
    max-height: 1400px;
    background-color: var(--color-main);
    border-radius: 48px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 36px 32px 32px 32px;
    align-items: stretch;
}

.map-equip-panel {
    width: 900px;
    max-height: 1200px;
    background-color: var(--color-main);
    border-radius: 48px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 36px 32px 32px 32px;
    align-items: center;
}

.map-equip-title {
    font-size: 40px;
    color: var(--color-black);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.map-equip-item-name {
    font-size: 30px;
    color: var(--color-black);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.map-equip-item-effect {
    font-size: 22px;
    color: var(--color-sub);
    -unity-text-align: middle-left;
    margin-top: 4px;
}

.map-equip-bio-panel {
    width: 900px;
    background-color: var(--color-white);
    border-radius: 48px;
    border-width: 2px;
    border-color: var(--color-sub);
    padding: 36px 32px;
    align-items: center;
}

.map-equip-bio-text {
    font-size: 26px;
    color: var(--color-black);
    -unity-text-align: middle-left;
    white-space: normal;
}

.map-inv-item {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-left;
    margin-bottom: 12px;
}

.map-inv-empty {
    font-size: 28px;
    color: rgba(0, 0, 0, 0.4);
    -unity-text-align: middle-center;
}

/* --- Message toast --- */
.map-message-box {
    position: absolute;
    left: 140px;
    right: 140px;
    height: 90px;
    border-radius: 32px;
    background-color: rgba(0, 0, 0, 0.85);
    align-items: center;
    justify-content: center;
    padding-left: 20px;
    padding-right: 20px;
}

.map-message-text {
    font-size: 24px;
    -unity-text-align: middle-center;
    color: white;
    white-space: normal;
}

/* --- Transition overlay text --- */
.map-transition-text {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    white-space: normal;
    width: 800px;
}

.map-encounter-text {
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    width: 800px;
}

/* --- Confirm text --- */
.map-confirm-text {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-black);
    white-space: normal;
    padding-left: 30px;
    padding-right: 30px;
    margin-bottom: 20px;
}

/* --- Milk cutin --- */
.milk-cutin-circle {
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background-color: rgba(255, 230, 235, 0.9);
    align-items: center;
    justify-content: center;
}

.milk-cutin-text-bg {
    width: 800px;
    height: 80px;
    background-color: rgba(255, 217, 230, 0.9);
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

.milk-cutin-text {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(153, 51, 77);
}

/* --- Milk NPC dialogue --- */
.milk-dialog-portrait {
    width: 300px;
    height: 400px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.milk-dialog-box {
    width: 1000px;
    background-color: rgba(255, 252, 248, 0.97);
    border-radius: 40px;
    padding-top: 24px;
    padding-bottom: 20px;
    padding-left: 36px;
    padding-right: 36px;
    margin-bottom: 80px;
}

.milk-dialog-name {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(140, 77, 128);
    margin-bottom: 10px;
}

.milk-dialog-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(51, 38, 26);
    white-space: normal;
    -unity-text-align: upper-left;
}

.elder-dialog-name {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(77, 89, 128);
    margin-bottom: 10px;
}

.milk-dialog-hint {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(153, 153, 166);
    -unity-text-align: middle-right;
    margin-top: 12px;
}

/* --- Weapon Shop panel --- */
.map-shop-panel {
    width: 700px;
    max-height: 1100px;
    background-color: rgba(255, 255, 255, 0.97);
    border-radius: 40px;
    padding: 30px 24px 24px 24px;
    align-items: center;
}

.map-shop-title {
    font-size: 36px;
    color: rgb(60, 60, 60);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.map-shop-milk {
    font-size: 26px;
    color: rgb(200, 120, 140);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.map-shop-row {
    width: 650px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgba(245, 240, 250, 1);
    border-radius: 24px;
}

.map-shop-item-name {
    font-size: 24px;
    color: rgb(40, 40, 40);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.map-shop-item-effect {
    font-size: 17px;
    color: rgb(100, 140, 200);
    -unity-text-align: middle-left;
    margin-top: 2px;
}

.map-shop-purchased {
    font-size: 20px;
    color: rgb(120, 180, 120);
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-left: 10px;
}

.map-shop-buy-btn {
    flex-shrink: 0;
    margin-left: 10px;
}

/* --- Touch swipe area --- */
.map-swipe-area {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* ======================================== */
/* 塾（じゅく）クイズパネル                   */
/* ======================================== */

.juku-panel {
    width: 900px;
    background-color: rgba(255, 252, 248, 0.97);
    border-radius: 48px;
    padding: 36px 32px 32px 32px;
    align-items: center;
    align-self: center;
    margin-bottom: 120px;
}

.juku-question-num {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(89, 51, 115);
    margin-bottom: 12px;
}

.juku-question-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(38, 38, 38);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 24px;
    padding-left: 20px;
    padding-right: 20px;
}

.juku-choice-btn {
    width: 780px;
    height: 100px;
    border-radius: 50px;
    background-color: white;
    border-width: 2px;
    border-color: rgb(89, 51, 115);
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.juku-choice-btn:active {
    scale: 0.95 0.95;
}

.juku-choice-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(38, 38, 38);
    -unity-text-align: middle-center;
}

.juku-result-text {
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 16px;
}
