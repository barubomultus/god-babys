/* ======================================== */
/* BirthStyle.uss — BirthScene              */
/* ======================================== */

/* --- Menu button (top-right circle) --- */
.birth-menu-btn {
    position: absolute;
    right: 24px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-menu-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

.birth-menu-line {
    width: 30px;
    height: 3.5px;
    background-color: rgb(115, 115, 128);
    margin-top: 4px;
    margin-bottom: 4px;
}

/* --- Menu overlay (backdrop) --- */
.birth-menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

/* --- Menu dropdown --- */
.birth-menu-card {
    position: absolute;
    right: 0px;
    width: 600px;
    padding: 64px;
    border-top-left-radius: 48px;
    border-bottom-left-radius: 48px;
    background-color: white;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.birth-menu-user-row {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.birth-menu-user-icon {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    margin-top: 32px;
    margin-bottom: 32px;
    background-color: rgb(217, 217, 217);
}

.birth-menu-user-name {
    font-size: 42px;
    margin-top: 32px;
    color: rgb(0, 0, 0);
    margin-left: 12px;
}

.birth-menu-separator {
    width: 100%;
    height: 1px;
    background-color: rgb(209, 209, 217);
    align-self: center;
    margin-bottom: 4px;
}

.birth-menu-item-btn {
    width: 100%;
    height: 96px;
    border-radius: 48px;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    color: #000;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-menu-item-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(240, 240, 243);
}

/* --- Parent card --- */
.birth-parent-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.birth-parent-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 94%;
    max-width: 1016px;
    height: 68%;
    border-radius: 40px;
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 40px;
}

.birth-parent-card-father {
    background-color: rgba(78, 110, 155, 0.9);
}

.birth-parent-card-mother {
    background-color: rgba(198, 103, 144, 0.9);
}

.birth-parent-inner {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-radius: 36px;
}

.birth-parent-inner-father {
    background-color: rgba(78, 110, 155, 0.9);
}

.birth-parent-inner-mother {
    background-color: rgba(198, 103, 144, 0.9);
}

.birth-parent-name {
    width: 100%;
    height: 52px;
    padding-left: 15px;
    padding-right: 15px;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    flex-shrink: 0;
}

.birth-parent-separator {
    width: 80%;
    height: 2px;
    flex-shrink: 0;
}

.birth-parent-separator-father {
    background-color: rgba(102, 128, 191, 0.6);
}

.birth-parent-separator-mother {
    background-color: rgba(191, 102, 140, 0.6);
}

.birth-parent-face {
    width: 85%;
    flex-grow: 1;
    align-self: center;
    -unity-background-scale-mode: scale-to-fit;
}

.birth-parent-intro {
    width: 100%;
    padding-left: 15px;
    padding-right: 15px;
    padding-bottom: 10px;
    min-height: 100px;
    font-size: 40px;
    -unity-text-align: middle-center;
    color: rgb(255, 230, 128);
    white-space: normal;
    flex-shrink: 0;
}

/* --- ステータス確認ボタン（アコーディオン展開） --- */
.birth-status-check-btn {
    align-self: center;
    width: 80%;
    max-width: 700px;
    height: 72px;
    border-radius: 36px;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-sub);
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 8px;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-status-check-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(255, 230, 240, 0.95);
}

/* --- アコーディオン（ステータス詳細） --- */
.birth-accordion {
    width: 96%;
    align-self: center;
    flex-shrink: 0;
    overflow: hidden;
}

.birth-accordion-inner {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 20px 16px;
    align-items: center;
}

.birth-accordion-catchphrase {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 230, 128);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
    padding-left: 8px;
    padding-right: 8px;
}

.birth-accordion-separator {
    width: 90%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.2);
    align-self: center;
    margin-bottom: 12px;
}

.birth-stat-row {
    flex-direction: row;
    align-items: center;
    width: 94%;
    margin-bottom: 8px;
}

.birth-stat-label {
    width: 120px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    flex-shrink: 0;
}

.birth-stat-bar-bg {
    flex-grow: 1;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-left: 8px;
    margin-right: 8px;
    overflow: hidden;
}

.birth-stat-bar-fill {
    height: 100%;
    border-radius: 11px;
    width: 0%;
}

.birth-stat-bar-fill-father {
    background-color: rgba(170, 210, 255, 0.9);
}

.birth-stat-bar-fill-mother {
    background-color: rgba(255, 183, 197, 0.9);
}

.birth-stat-value {
    width: 60px;
    font-size: 22px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

/* --- Bio を見るボタン（アコーディオン内） --- */
.birth-bio-view-btn {
    align-self: center;
    width: 80%;
    max-width: 600px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 230, 200, 0.9);
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(120, 80, 40);
    margin-top: 16px;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-bio-view-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(255, 210, 170, 0.95);
}

/* --- カード裏面（Bio / 紹介文） --- */
.birth-card-back {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-radius: 48px;
    background-color: rgba(245, 228, 200, 0.95);
    flex-direction: column;
    align-items: center;
    padding: 30px 24px;
    overflow: hidden;
}

.birth-card-back-title {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(120, 80, 40);
    margin-bottom: 8px;
}

.birth-card-back-name {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(80, 60, 40);
    margin-bottom: 16px;
}

.birth-card-back-separator {
    width: 80%;
    height: 2px;
    background-color: rgba(160, 120, 80, 0.4);
    align-self: center;
    margin-bottom: 20px;
}

.birth-card-back-bio {
    font-size: 30px;
    color: rgb(80, 60, 40);
    white-space: normal;
    -unity-text-align: upper-left;
    padding-left: 16px;
    padding-right: 16px;
    flex-grow: 1;
}

.birth-card-back-btn {
    align-self: center;
    width: 70%;
    max-width: 500px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(200, 170, 130, 0.9);
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(80, 60, 40);
    margin-top: 12px;
    flex-shrink: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-card-back-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(180, 150, 110, 0.95);
}

.birth-next-btn-wrapper {
    position: absolute;
    left: 50%;
    bottom: 8%;
    translate: -50% 0;
}

.birth-next-btn {
    width: 700px;
    height: 120px;
    border-radius: 60px;
    background-color: white;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(115, 115, 128);
    border-width: 1px;
    border-color: rgb(200, 200, 210);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
    padding: 0;
}

.birth-next-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

/* --- Name input dialog --- */
.birth-name-card {
    width: 84%;
    border-radius: 40px;
    background-color: white;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 30px;
}

.birth-name-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(64, 64, 77);
    -unity-text-align: middle-center;
    margin-bottom: 25px;
}

.birth-name-field .unity-text-field__input {
    width: 100%;
    height: 80px;
    font-size: 32px;
    color: rgb(38, 38, 38);
    background-color: rgb(240, 240, 245);
    border-radius: 28px;
    border-width: 0;
    padding-left: 15px;
    padding-right: 15px;
}

.birth-name-field {
    width: 85%;
    margin-bottom: 25px;
}

.birth-name-btn-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 85%;
}

.birth-name-confirm-btn {
    height: 90px;
    flex-grow: 1;
    border-radius: 45px;
    background-color: rgb(200, 40, 40);
    align-items: center;
    justify-content: center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    border-width: 0;
    padding: 0;
    margin-right: 16px;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-name-confirm-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(160, 30, 30);
}

.birth-name-back-btn {
    height: 90px;
    flex-grow: 1;
    border-radius: 45px;
    background-color: rgb(200, 200, 210);
    align-items: center;
    justify-content: center;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(64, 64, 77);
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-name-back-btn:active {
    scale: 0.95 0.95;
}

/* --- Save confirm dialog --- */
.birth-save-panel {
    width: 400px;
    background-color: rgba(26, 26, 51, 0.95);
    border-radius: 40px;
    padding: 30px 20px 20px 20px;
    align-items: center;
}

.birth-save-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.birth-save-yes {
    width: 120px;
    height: 50px;
    border-radius: 25px;
    background-color: rgb(77, 179, 102);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    margin-right: 16px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-save-yes:active {
    scale: 0.95 0.95;
}

.birth-save-no {
    width: 120px;
    height: 50px;
    border-radius: 25px;
    background-color: rgb(153, 77, 77);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-save-no:active {
    scale: 0.95 0.95;
}

/* --- Parent bio panel --- */
/* --- 邂逅の記憶: アルバム風全画面パネル --- */
.birth-story-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(245, 235, 218);
}

.birth-story-bg-wrapper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    scale: 1 -1;
    opacity: 0.15;
}

.birth-story-title {
    flex-shrink: 0;
    padding-top: 64px;
    padding-bottom: 16px;
    font-size: 52px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(80, 60, 40);
    letter-spacing: 2px;
}

/* --- ポラロイド2枚並び --- */
.birth-story-album-content {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-top: 16px;
    padding-bottom: 8px;
}

.birth-story-album-card {
    width: 460px;
    flex-shrink: 0;
    position: relative;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
}

.birth-story-polaroid-frame {
    background-color: rgb(255, 255, 255);
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 44px;
    align-items: center;
    align-self: center;
}

.birth-story-polaroid-inner {
    width: 280px;
    height: 280px;
    overflow: hidden;
}

.birth-story-polaroid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.birth-story-polaroid-caption {
    font-size: 28px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(60, 40, 25);
    margin-top: 6px;
    letter-spacing: 1px;
}

.birth-story-corner-seal {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgba(180, 150, 90, 0.45);
    border-radius: 2px;
}

.birth-story-card-intro {
    flex-shrink: 0;
    margin-top: 16px;
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    color: rgb(60, 40, 25);
    white-space: normal;
    letter-spacing: 1px;
}

/* --- 装飾線 --- */
.birth-story-album-divider {
    flex-shrink: 0;
    width: 800px;
    height: 2px;
    background-color: rgba(160, 130, 90, 0.5);
    align-self: center;
    margin-top: 16px;
    margin-bottom: 8px;
}

/* --- ストーリーテキスト --- */
.birth-story-text {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 5%;
    padding-right: 5%;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 36px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(60, 40, 25);
    white-space: normal;
    letter-spacing: 1px;
    -unity-paragraph-spacing: 12px;
}

/* --- 「愛を育む」ボタン行 --- */
.birth-story-love-btn-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-bottom: 100px;
    padding-top: 16px;
}

.birth-story-love-btn {
    width: 600px;
    height: 100px;
    border-radius: 50px;
    background-color: rgb(198, 160, 80);
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    border-width: 0;
    transition-property: scale;
    transition-duration: 0.08s;
    padding: 0;
}

.birth-story-love-btn:active {
    scale: 0.95 0.95;
}

/* --- Birth result centering container --- */
.birth-result-container {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 16%;
    justify-content: center;
    align-items: center;
}

/* --- Polaroid birth result --- */
.birth-polaroid-wrapper {
    position: relative;
    width: 85%;
    max-width: 920px;
    max-height: 95%;
    flex-shrink: 1;
}

.birth-polaroid-shadow {
    position: absolute;
    left: 12px;
    top: 12px;
    right: -12px;
    bottom: -12px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 6px;
}

.birth-polaroid-frame {
    width: 100%;
    position: relative;
    background-color: white;
    border-radius: 4px;
    padding-top: 20px;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    align-items: center;
    flex-shrink: 1;
}

.birth-polaroid-photo {
    width: 100%;
    aspect-ratio: 1;
    flex-shrink: 1;
    overflow: hidden;
    background-color: rgb(35, 30, 45);
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-polaroid-photo:active {
    scale: 0.98 0.98;
}

.birth-polaroid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.birth-polaroid-placeholder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 52px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 2px;
}

.birth-trait-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
    margin-bottom: 4px;
}

.birth-trait-badge {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 16px;
    background-color: rgb(198, 160, 80);
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.15);
}

.birth-baby-name {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(60, 40, 25);
    -unity-text-align: middle-center;
    margin-top: 12px;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.1);
}

.birth-baby-bio {
    width: 96%;
    margin-top: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(255, 248, 230, 0.75);
    border-radius: 24px;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(70, 50, 30);
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.08);
}

.birth-memo-tape {
    width: 96%;
    margin-top: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(255, 235, 200, 0.7);
    border-radius: 4px;
    rotate: -1deg;
}

.birth-memo-text {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(80, 60, 40);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.08);
}

.birth-parents-line {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgba(80, 60, 40, 0.6);
    -unity-text-align: middle-center;
    margin-top: 8px;
    white-space: normal;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.06);
}

.birth-polaroid-screenshot-btn {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-text-align: middle-center;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-polaroid-screenshot-btn:active {
    scale: 0.9 0.9;
}

/* --- Face adjustment overlay --- */
.face-adjust-card {
    width: 940px;
    background-color: white;
    border-radius: 40px;
    border-width: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 30px;
}

.face-adjust-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(51, 38, 26);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.face-adjust-preview {
    width: 700px;
    height: 700px;
    align-items: center;
    justify-content: center;
}

.face-adjust-face-img {
    -unity-background-scale-mode: scale-and-crop;
}

.face-adjust-wear {
    position: absolute;
    width: 700px;
    height: 700px;
    -unity-background-scale-mode: scale-to-fit;
}

.face-adjust-slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 16px;
}

.face-adjust-slider-label {
    font-size: 30px;
    color: rgb(51, 38, 26);
    margin-right: 16px;
}

.face-adjust-slider {
    width: 400px;
}

.face-adjust-slider .unity-base-slider__dragger {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(77, 179, 102);
    margin-top: -18px;
}

.face-adjust-slider .unity-base-slider__tracker {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.15);
    margin-top: -1px;
}

.face-adjust-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.face-adjust-confirm-btn {
    width: 240px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(77, 179, 102);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-right: 24px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.face-adjust-confirm-btn:active {
    scale: 0.95 0.95;
}

.face-adjust-cancel-btn {
    width: 240px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(153, 77, 77);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.face-adjust-cancel-btn:active {
    scale: 0.95 0.95;
}

/* --- Skip button wrapper (flexboxで右下寄せ) --- */
.cutin-skip-wrapper {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding-right: 30px;
    padding-bottom: 60px;
}

/* --- Skip button --- */
.cutin-skip-btn {
    width: 160px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.cutin-skip-btn:active {
    background-color: rgba(255, 255, 255, 0.35);
}

/* --- Name tape (confirmation animation) --- */
.birth-name-tape {
    align-self: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 28px;
    padding-right: 28px;
    margin-bottom: 8px;
    background-color: rgba(255, 240, 200, 0.88);
    border-radius: 4px;
    border-left-width: 4px;
    border-left-color: rgba(200, 160, 80, 0.6);
    border-right-width: 4px;
    border-right-color: rgba(200, 160, 80, 0.6);
    position: relative;
    overflow: visible;
}

.birth-name-tape-text {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(60, 40, 25);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

/* --- Tape sparkle particle --- */
.birth-tape-sparkle {
    -unity-text-align: middle-center;
}

/* --- Share mode buttons --- */
.birth-share-wrapper {
    align-self: center;
    align-items: center;
    margin-top: auto;
    padding-bottom: 5%;
}

.birth-share-btn {
    width: 600px;
    height: 100px;
    border-radius: 50px;
    background-color: rgb(77, 166, 255);
    border-width: 0;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-share-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(60, 140, 220);
}

.birth-share-battle-btn {
    width: 600px;
    height: 100px;
    border-radius: 50px;
    background-color: rgb(230, 80, 70);
    border-width: 0;
    padding: 0;
    font-size: 34px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-share-battle-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(200, 60, 50);
}
