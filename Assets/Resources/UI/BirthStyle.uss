/* ======================================== */
/* BirthStyle.uss — BirthScene              */
/* ======================================== */

/* --- Menu button (top-right circle) --- */
.birth-menu-btn {
    position: absolute;
    right: 24px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-menu-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

.birth-menu-line {
    width: 30px;
    height: 3.5px;
    background-color: rgb(115, 115, 128);
    margin-top: 4px;
    margin-bottom: 4px;
}

/* --- Menu overlay (backdrop) --- */
.birth-menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

/* --- Menu dropdown --- */
.birth-menu-card {
    position: absolute;
    right: 0px;
    width: 600px;
    padding: 64px;
    border-top-left-radius: 32px;
    border-bottom-left-radius: 32px;
    background-color: white;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.birth-menu-user-row {
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin-top: 8px;
    margin-bottom: 8px;
}

.birth-menu-user-icon {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    margin-top: 32px;
    margin-bottom: 32px;
    background-color: rgb(217, 217, 217);
}

.birth-menu-user-name {
    font-size: 42px;
    margin-top: 32px;
    color: rgb(0, 0, 0);
    margin-left: 12px;
}

.birth-menu-separator {
    width: 100%;
    height: 1px;
    background-color: rgb(209, 209, 217);
    align-self: center;
    margin-bottom: 4px;
}

.birth-menu-item-btn {
    width: 100%;
    height: 96px;
    border-radius: 16px;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    color: #000;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-menu-item-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(240, 240, 243);
}

/* --- Parent card --- */
.birth-parent-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.birth-parent-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1016px;
    height: 1300px;
    border-radius: 24px;
    align-items: center;
}

.birth-parent-card-father {
    background-color: rgba(78, 110, 155, 0.9);
}

.birth-parent-card-mother {
    background-color: rgba(198, 103, 144, 0.9);
}

.birth-parent-inner {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-radius: 20px;
}

.birth-parent-inner-father {
    background-color: rgba(78, 110, 155, 0.9);
}

.birth-parent-inner-mother {
    background-color: rgba(198, 103, 144, 0.9);
}

.birth-parent-name {
    position: absolute;
    top: 10px;
    left: 15px;
    right: 15px;
    height: 70px;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
}

.birth-parent-separator {
    position: absolute;
    top: 85px;
    left: 10%;
    right: 10%;
    height: 2px;
}

.birth-parent-separator-father {
    background-color: rgba(102, 128, 191, 0.6);
}

.birth-parent-separator-mother {
    background-color: rgba(191, 102, 140, 0.6);
}

.birth-parent-face {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -45%;
    width: 850px;
    height: 850px;
}

.birth-parent-intro {
    position: absolute;
    bottom: 40px;
    left: 15px;
    right: 15px;
    height: 130px;
    font-size: 40px;
    -unity-text-align: middle-center;
    color: rgb(255, 230, 128);
    white-space: normal;
}

.birth-parent-info-btn {
    position: absolute;
    right: 30px;
    top: 30px;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 38px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(51, 77, 140);
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-parent-info-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(217, 217, 230);
}

.birth-next-btn-wrapper {
    position: absolute;
    left: 50%;
    bottom: 160px;
    translate: -50% 0;
}

.birth-next-btn {
    width: 700px;
    height: 120px;
    border-radius: 60px;
    background-color: white;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(115, 115, 128);
    border-width: 1px;
    border-color: rgb(200, 200, 210);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
    padding: 0;
}

.birth-next-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

/* --- Name input dialog --- */
.birth-name-card {
    width: 900px;
    border-radius: 24px;
    background-color: white;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 30px;
}

.birth-name-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(64, 64, 77);
    -unity-text-align: middle-center;
    margin-bottom: 25px;
}

.birth-name-field .unity-text-field__input {
    width: 750px;
    height: 80px;
    font-size: 32px;
    color: rgb(38, 38, 38);
    background-color: rgb(240, 240, 245);
    border-radius: 16px;
    border-width: 0;
    padding-left: 15px;
    padding-right: 15px;
}

.birth-name-field {
    width: 750px;
    margin-bottom: 25px;
}

/* --- Save confirm dialog --- */
.birth-save-panel {
    width: 400px;
    background-color: rgba(26, 26, 51, 0.95);
    border-radius: 12px;
    padding: 30px 20px 20px 20px;
    align-items: center;
}

.birth-save-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.birth-save-yes {
    width: 120px;
    height: 50px;
    border-radius: 8px;
    background-color: rgb(77, 179, 102);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    margin-right: 16px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-save-yes:active {
    scale: 0.95 0.95;
}

.birth-save-no {
    width: 120px;
    height: 50px;
    border-radius: 8px;
    background-color: rgb(153, 77, 77);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.birth-save-no:active {
    scale: 0.95 0.95;
}

/* --- Parent bio panel --- */
.birth-bio-card {
    width: 940px;
    background-color: rgba(26, 36, 71, 0.98);
    border-radius: 24px;
    border-color: rgba(64, 89, 153, 0.95);
    border-width: 6px;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 20px;
}

.birth-bio-name {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 230, 128);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.birth-bio-separator {
    width: 90%;
    height: 2px;
    background-color: rgba(102, 128, 191, 0.5);
    align-self: center;
    margin-bottom: 15px;
}

.birth-bio-text {
    font-size: 32px;
    color: white;
    -unity-text-align: upper-left;
    white-space: normal;
    padding-left: 36px;
    padding-right: 36px;
    margin-bottom: 15px;
    -unity-line-height: 120%;
}

.birth-bio-close {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.15);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 36px;
    color: white;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.birth-bio-close:active {
    background-color: rgba(255, 255, 255, 0.3);
}

/* --- 邂逅の記憶: アルバム風全画面パネル --- */
.birth-story-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(245, 235, 218);
}

.birth-story-bg-wrapper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    scale: 1 -1;
    opacity: 0.15;
}

.birth-story-title {
    flex-shrink: 0;
    padding-top: 64px;
    padding-bottom: 16px;
    font-size: 52px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(80, 60, 40);
    letter-spacing: 2px;
}

/* --- ポラロイド2枚並び --- */
.birth-story-album-content {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-top: 16px;
    padding-bottom: 8px;
}

.birth-story-album-card {
    width: 460px;
    flex-shrink: 0;
    position: relative;
    align-items: center;
    margin-left: 10px;
    margin-right: 10px;
}

.birth-story-polaroid-frame {
    background-color: rgb(255, 255, 255);
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 44px;
    align-items: center;
    align-self: center;
}

.birth-story-polaroid-inner {
    width: 280px;
    height: 280px;
    overflow: hidden;
}

.birth-story-polaroid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.birth-story-polaroid-caption {
    font-size: 28px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(60, 40, 25);
    margin-top: 6px;
    letter-spacing: 1px;
}

.birth-story-corner-seal {
    position: absolute;
    width: 32px;
    height: 32px;
    background-color: rgba(180, 150, 90, 0.45);
    border-radius: 2px;
}

.birth-story-card-intro {
    flex-shrink: 0;
    margin-top: 16px;
    font-size: 32px;
    -unity-text-align: middle-center;
    -unity-font-style: bold-and-italic;
    color: rgb(60, 40, 25);
    white-space: normal;
    letter-spacing: 1px;
}

/* --- 装飾線 --- */
.birth-story-album-divider {
    flex-shrink: 0;
    width: 800px;
    height: 2px;
    background-color: rgba(160, 130, 90, 0.5);
    align-self: center;
    margin-top: 16px;
    margin-bottom: 8px;
}

/* --- ストーリーテキスト --- */
.birth-story-text {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 5%;
    padding-right: 5%;
    padding-top: 16px;
    padding-bottom: 16px;
    font-size: 36px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-center;
    color: rgb(60, 40, 25);
    white-space: normal;
    letter-spacing: 1px;
    -unity-paragraph-spacing: 12px;
}

/* --- 「愛を育む」ボタン行 --- */
.birth-story-love-btn-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-bottom: 100px;
    padding-top: 16px;
}

.birth-story-love-btn {
    width: 600px;
    height: 100px;
    border-radius: 12px;
    background-color: rgb(198, 160, 80);
    -unity-text-align: middle-center;
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    border-width: 0;
    transition-property: scale;
    transition-duration: 0.08s;
    padding: 0;
}

.birth-story-love-btn:active {
    scale: 0.95 0.95;
}

/* --- Birth result card --- */
.birth-result-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1016px;
    height: 1300px;
    translate: -508px -800px;
    border-radius: 24px;
    background-color: rgb(209, 209, 217);
}

.birth-result-inner {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-radius: 20px;
    background-color: rgb(243, 247, 248);
    overflow: hidden;
}

.birth-result-gender {
    position: absolute;
    top: 10px;
    left: 15px;
    right: 15px;
    height: 70px;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(64, 64, 77);
}

.birth-result-separator {
    position: absolute;
    top: 85px;
    left: 10%;
    right: 10%;
    height: 2px;
    background-color: rgba(199, 199, 209, 0.6);
}

.birth-result-status-card {
    position: absolute;
    left: 3%;
    right: 3%;
    bottom: 1%;
    height: 29%;
    border-radius: 24px;
    background-color: rgb(209, 209, 217);
}

.birth-result-status-inner {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 6px;
    bottom: 6px;
    border-radius: 20px;
    background-color: rgb(243, 247, 248);
    padding: 12px 28px;
}

.birth-result-status-text {
    font-size: 28px;
    color: rgb(26, 26, 26);
    white-space: normal;
}

.birth-result-upload-btn {
    position: absolute;
    left: 50%;
    bottom: 31%;
    translate: -32px 0;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(89, 89, 102, 0.8);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
    color: white;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.birth-result-upload-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(64, 64, 77, 1);
}

.birth-result-custom-image {
    position: absolute;
    width: 950px;
    height: 950px;
    left: 50%;
    top: 60px;
    translate: -475px 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- Face adjustment overlay --- */
.face-adjust-card {
    width: 940px;
    background-color: rgba(26, 36, 71, 0.98);
    border-radius: 24px;
    border-color: rgba(64, 89, 153, 0.95);
    border-width: 6px;
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
    padding-bottom: 30px;
}

.face-adjust-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(255, 230, 128);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.face-adjust-preview {
    width: 700px;
    height: 700px;
    align-items: center;
    justify-content: center;
}

.face-adjust-face-img {
    -unity-background-scale-mode: scale-and-crop;
}

.face-adjust-wear {
    position: absolute;
    width: 700px;
    height: 700px;
    -unity-background-scale-mode: scale-to-fit;
}

.face-adjust-slider-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 16px;
}

.face-adjust-slider-label {
    font-size: 30px;
    color: white;
    margin-right: 16px;
}

.face-adjust-slider {
    width: 400px;
}

.face-adjust-slider .unity-base-slider__dragger {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(255, 230, 128);
    margin-top: -18px;
}

.face-adjust-slider .unity-base-slider__tracker {
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.3);
    margin-top: -1px;
}

.face-adjust-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
}

.face-adjust-confirm-btn {
    width: 240px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(77, 179, 102);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    margin-right: 24px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.face-adjust-confirm-btn:active {
    scale: 0.95 0.95;
}

.face-adjust-cancel-btn {
    width: 240px;
    height: 80px;
    border-radius: 40px;
    background-color: rgb(153, 77, 77);
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: white;
    transition-property: scale;
    transition-duration: 0.08s;
}

.face-adjust-cancel-btn:active {
    scale: 0.95 0.95;
}

/* --- Skip button wrapper (flexboxで右下寄せ) --- */
.cutin-skip-wrapper {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding-right: 30px;
    padding-bottom: 60px;
}

/* --- Skip button --- */
.cutin-skip-btn {
    width: 160px;
    height: 64px;
    border-radius: 32px;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    padding: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.7);
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.cutin-skip-btn:active {
    background-color: rgba(255, 255, 255, 0.35);
}
