/* ======================================== */
/* BattleStyle.uss — BattleScene (flexbox)  */
/* ======================================== */

/* === Main layout === */
.battle-root {
    flex-grow: 1;
    flex-direction: column;
}

.battle-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-and-crop;
}

.battle-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
}

/* === Enemy area (top) === */
.battle-enemy-area {
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
}

/* === Player area (bottom) === */
.battle-player-area {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-start;
    margin-top: auto;
    margin-bottom: 240px;
    padding-left: 86px;
}

/* === Center (VS + log) === */
.battle-center {
    flex-shrink: 0;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* === Character panel (shared base) === */
.battle-char-panel {
    flex-direction: column;
    align-items: center;
}

/* === Player card === */
.battle-char-card {
    width: 504px;
    background-color: var(--color-main);
    align-items: stretch;
    border-radius: 40px;
    overflow: hidden;
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-top-color: var(--color-sub);
    border-left-color: var(--color-sub);
    border-right-color: var(--color-sub);
    border-bottom-color: rgba(0, 0, 0, 0.25);
}

/* === Info column (name, HP bar, HP text) === */
.battle-info-col {
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
}

/* === Enemy info (below image, wider) === */
.battle-info-col-enemy {
    width: 400px;
    align-items: center;
    padding-top: 14px;
}

/* === Name + Age row === */
.battle-name-age-row {
    flex-shrink: 0;
    flex-direction: row;
    width: 100%;
    align-items: center;
}

/* === Name label === */
.battle-char-name {
    flex-shrink: 1;
    flex-grow: 1;
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: var(--color-black);
    white-space: normal;
}

.battle-name-player {
    color: var(--color-black);
}

.battle-name-enemy {
    color: var(--color-black);
}

/* === Face mask (player card) === */
.battle-face-mask {
    width: 100%;
    height: 468px;
    flex-shrink: 0;
    border-radius: 0;
    overflow: hidden;
    background-color: var(--color-white);
}

/* === Face mask (enemy, large centered) === */
.battle-face-mask-enemy {
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background-color: transparent;
}

/* === Age label === */
.battle-age-label {
    flex-shrink: 0;
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-right;
}

/* === HP bar === */
.battle-hp-bg {
    flex-shrink: 0;
    height: 16px;
    width: 100%;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.12);
    margin-top: 10px;
    flex-direction: row;
}

.battle-hp-fill {
    height: 100%;
    border-radius: 12px;
}

.battle-hp-fill-player {
    background-color: var(--color-accent);
}

.battle-hp-fill-enemy {
    background-color: var(--color-sub);
}

/* === HP text === */
.battle-hp-text {
    flex-shrink: 0;
    height: 36px;
    width: 100%;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--color-black);
    margin-top: 4px;
}

/* === VS text === */
.battle-vs {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--color-sub);
    -unity-text-align: middle-center;
}

/* === Battle log === */
.battle-log {
    width: 1000px;
    height: 160px;
    border-radius: 32px;
    background-color: var(--color-main);
    border-width: 2px;
    border-color: var(--color-sub);
    align-items: center;
    justify-content: center;
    padding-left: 15px;
    padding-right: 15px;
    padding-top: 8px;
    padding-bottom: 8px;
    overflow: hidden;
}

.battle-log-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.battle-log-text {
    font-size: 40px;
    color: var(--color-black);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* === Action area (pinned to bottom) === */
.battle-action-area {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-top: 14px;
    background-color: var(--color-main);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-top-width: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-color: var(--color-sub);
}

/* === Command row (4 buttons) === */
.battle-cmd-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    width: 100%;
    padding-left: 10px;
    padding-right: 10px;
}

.battle-cmd-btn {
    width: 20%;
    height: 100px;
    border-radius: 50px;
    margin-left: 10px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-black);
    background-color: var(--color-white);
    border-top-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 6px;
    border-top-color: var(--color-sub);
    border-left-color: var(--color-sub);
    border-right-color: var(--color-sub);
    border-bottom-color: rgba(0, 0, 0, 0.18);
    transition-property: scale, background-color, border-bottom-width;
    transition-duration: 0.08s;
}

.battle-cmd-btn:hover {
    background-color: var(--color-sub);
    color: var(--color-white);
}

.battle-cmd-btn:active {
    scale: 0.95 0.95;
    background-color: var(--color-sub);
    color: var(--color-white);
    border-bottom-width: 2px;
}

/* === Submenu === */
.battle-submenu {
    width: 94%;
    flex-direction: column;
    align-items: center;
    margin-top: 8px;
}

.battle-submenu-item {
    width: 100%;
    height: 88px;
    border-radius: 44px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: var(--color-sub);
    margin-top: 6px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--color-black);
    transition-property: scale, background-color, color;
    transition-duration: 0.08s;
}

.battle-submenu-item:active {
    scale: 0.97 0.97;
    background-color: var(--color-sub);
    color: var(--color-white);
}

.battle-submenu-back {
    background-color: var(--color-main);
    border-color: rgba(0, 0, 0, 0.12);
    color: var(--color-black);
}

.battle-submenu-item-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-center;
}

.battle-submenu-item-desc {
    font-size: 20px;
    color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-center;
    white-space: normal;
}

.battle-submenu-empty {
    font-size: 30px;
    color: rgba(0, 0, 0, 0.4);
    -unity-text-align: middle-center;
    margin-top: 16px;
    margin-bottom: 8px;
}

/* === Top bar (にげる左 / AUTO右, アクションエリアの上) === */
.battle-top-bar {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 10px;
}

.battle-run-pill {
    height: 56px;
    border-radius: 28px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.15);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 0.08s;
}

.battle-run-pill:active {
    background-color: var(--color-sub);
    color: var(--color-white);
}

.battle-auto-pill {
    height: 56px;
    border-radius: 28px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 2px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.battle-auto-pill:active {
    scale: 0.96 0.96;
}

.battle-auto-off {
    background-color: var(--color-white);
    border-color: rgba(0, 0, 0, 0.15);
    color: var(--color-black);
}

.battle-auto-on {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-black);
}

.battle-action-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
}

/* === Action button === */
.battle-action-btn {
    width: 460px;
    height: 120px;
    border-radius: 40px;
    background-color: white;
    border-width: 2px;
    border-color: rgb(192, 192, 204);
    margin-left: 10px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.battle-action-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

.battle-action-btn-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(115, 115, 128);
    -unity-text-align: middle-center;
}

.battle-action-label {
    position: absolute;
    top: -24px;
    font-size: 20px;
    color: rgb(204, 204, 217);
    -unity-text-align: middle-center;
    align-self: center;
}

.battle-action-info {
    position: absolute;
    right: 4px;
    top: 4px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(217, 217, 230);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 28px;
    -unity-font-style: bold-and-italic;
    color: rgb(128, 128, 140);
    transition-property: scale;
    transition-duration: 0.08s;
}

.battle-action-info:active {
    scale: 0.90 0.90;
}

/* === Skill popup === */
.battle-skill-popup {
    width: 500px;
    height: 280px;
    border-radius: 40px;
    background-color: rgba(30, 30, 56, 0.95);
    flex-direction: column;
    align-items: center;
    padding-top: 10px;
}

.battle-skill-icon-area {
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background-color: rgba(20, 20, 38, 0.8);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.battle-skill-title {
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.battle-skill-desc {
    font-size: 36px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    padding-left: 20px;
    padding-right: 20px;
    margin-top: 8px;
    flex-grow: 1;
}

/* === Encounter intro === */
.battle-encounter-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.88);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.battle-encounter-overlay-hide {
    opacity: 0;
}

.battle-ui-fadein {
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

.battle-encounter-img {
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.08);
    opacity: 0;
    scale: 0.3 0.3;
    transform-origin: center bottom;
}

.battle-encounter-text {
    font-size: 44px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 800px;
    margin-top: 40px;
    opacity: 0;
    translate: 0 30px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}

.battle-encounter-text-visible {
    opacity: 1;
    translate: 0 0;
}

/* === Growth overlay === */
.battle-growth-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-main);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.battle-growth-title {
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-center;
}

.battle-growth-subtitle {
    font-size: 30px;
    color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 20px;
}

.battle-growth-row {
    width: 920px;
    height: 120px;
    border-radius: 30px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: var(--color-sub);
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.battle-growth-row-visible {
    opacity: 1;
    scale: 1 1;
}

.battle-growth-bar {
    width: 6px;
    height: 70%;
    border-radius: 3px;
    margin-left: 28px;
}

.battle-growth-label {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 20px;
    width: 180px;
    white-space: nowrap;
}

.battle-growth-old {
    font-size: 38px;
    color: rgba(0, 0, 0, 0.35);
    -unity-text-align: middle-right;
    width: 130px;
}

.battle-growth-arrow {
    font-size: 36px;
    color: var(--color-sub);
    -unity-text-align: middle-center;
    width: 70px;
}

.battle-growth-new {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-left;
    width: 130px;
}

.battle-growth-diff {
    height: 44px;
    border-radius: 22px;
    padding-left: 14px;
    padding-right: 14px;
    align-items: center;
    justify-content: center;
    margin-left: 10px;
}

.battle-growth-diff-text {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battle-growth-ok-btn {
    width: 500px;
    height: 90px;
    border-radius: 45px;
    background-color: var(--color-sub);
    border-width: 0;
    align-self: center;
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--color-white);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.battle-growth-ok-btn:active {
    scale: 0.95 0.95;
    background-color: rgba(255, 183, 197, 0.8);
}

/* === EXP bar === */
.battle-exp-bar-bg {
    width: 80%;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.12);
    margin-top: 10px;
    align-self: center;
}

.battle-exp-bar-fill {
    height: 100%;
    border-radius: 10px;
    background-color: var(--color-accent);
}

/* === Battle result overlay === */
.battle-result-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-main);
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.battle-result-title {
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    white-space: normal;
    width: 800px;
}

.battle-result-card {
    width: 820px;
    border-radius: 40px;
    background-color: var(--color-white);
    border-width: 2px;
    border-color: var(--color-sub);
    padding-top: 30px;
    padding-bottom: 30px;
    padding-left: 40px;
    padding-right: 40px;
    flex-direction: column;
}

.battle-result-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 80px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.08);
}

.battle-result-row-label {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-black);
    -unity-text-align: middle-left;
}

.battle-result-row-value {
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.battle-result-value-accent {
    color: var(--color-accent);
}

.battle-result-value-sub {
    color: var(--color-sub);
}

.battle-result-bar-label {
    font-size: 26px;
    color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-center;
    margin-top: 20px;
    margin-bottom: 8px;
}

.battle-result-bar-bg {
    width: 100%;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.1);
}

.battle-result-bar-fill {
    height: 100%;
    border-radius: 10px;
    background-color: var(--color-accent);
}

.battle-result-levelup {
    font-size: 38px;
    -unity-font-style: bold;
    color: var(--color-sub);
    -unity-text-align: middle-center;
    margin-top: 24px;
}

/* === Boss defeat panel === */
.battle-boss-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.8s;
}

.battle-boss-panel-dark {
    background-color: rgba(0, 0, 0, 0.95);
}

.battle-boss-line {
    font-size: 32px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 800px;
    opacity: 0;
    translate: -800px 0;
    transition-property: translate, opacity;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
    margin-top: 20px;
    margin-bottom: 20px;
}

.battle-boss-line-visible {
    translate: 0 0;
    opacity: 1;
}

.battle-boss-line-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 77, 77);
}

/* === Victory panel === */
.battle-victory-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.battle-victory-text {
    font-size: 64px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 800px;
}

/* === Cut-in === */
.battle-cutin {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
    opacity: 0;
    scale: 0.5 0.5;
}

/* === Start / Victory image wrapper === */
.battle-image-wrapper {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.battle-image-center {
    width: 800px;
    height: 400px;
    -unity-background-scale-mode: scale-to-fit;
}

/* === Menu button (top-right circle) === */
.battle-menu-btn {
    position: absolute;
    right: 24px;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.battle-menu-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(235, 235, 235);
}

.battle-menu-line {
    width: 30px;
    height: 3.5px;
    background-color: rgb(115, 115, 128);
    margin-top: 4px;
    margin-bottom: 4px;
}

/* --- Menu dropdown --- */
.battle-menu-card {
    position: absolute;
    right: 24px;
    width: 280px;
    border-radius: 40px;
    background-color: white;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.battle-menu-item-btn {
    width: 260px;
    height: 60px;
    border-radius: 30px;
    background-color: white;
    align-items: center;
    justify-content: center;
    border-width: 0;
    padding: 0;
    font-size: 30px;
    color: rgb(26, 26, 33);
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.battle-menu-item-btn:active {
    scale: 0.95 0.95;
    background-color: rgb(240, 240, 243);
}

/* --- Game Over panel --- */
.battle-gameover-card {
    width: 900px;
    border-radius: 48px;
    background-color: white;
    align-items: center;
    padding-top: 60px;
    padding-bottom: 40px;
}

.battle-gameover-title {
    font-size: 80px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(0, 0, 0);
    margin-bottom: 10px;
}

.battle-gameover-msg {
    font-size: 36px;
    -unity-text-align: middle-center;
    color: rgb(77, 77, 89);
    margin-bottom: 30px;
    padding-left: 30px;
    padding-right: 30px;
    white-space: normal;
}
