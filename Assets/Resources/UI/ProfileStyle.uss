/* ======================================== */
/* ProfileStyle.uss — ProfileScene          */
/* ======================================== */

/* --- Avatar area --- */
.avatar-btn {
    width: 236px;
    height: 236px;
    align-self: center;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.avatar-btn:active {
    scale: 0.95 0.95;
}

.avatar-circle {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: white;
}

.avatar-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.edit-badge {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: rgb(77, 128, 230);
    align-items: center;
    justify-content: center;
    right: 8px;
    bottom: 8px;
}

.edit-badge-text {
    font-size: 28px;
    color: white;
    -unity-text-align: middle-center;
}

/* --- Name input area --- */
.name-label {
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(13, 13, 20);
    margin-top: 30px;
}

.name-input {
    width: 800px;
    height: 100px;
    align-self: center;
    margin-top: 20px;
    font-size: 44px;
    background-color: white;
    border-radius: 40px;
    border-width: 2px;
    border-color: rgb(204, 204, 204);
    padding-left: 20px;
    padding-right: 20px;
    color: black;
}

.name-input .unity-text-field__input {
    font-size: 44px;
    background-color: white;
    border-width: 0;
    padding-left: 10px;
    color: black;
}

/* --- Icon picker overlay --- */
.icon-picker-card {
    width: 900px;
    height: 700px;
    background-color: white;
    border-radius: 40px;
    align-items: center;
    padding-top: 20px;
}

.picker-title {
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(64, 64, 77);
    margin-bottom: 20px;
}

.icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    padding-left: 60px;
    padding-right: 60px;
}

.picker-icon-container {
    width: 140px;
    height: 140px;
    margin: 15px 20px;
    border-radius: 50%;
    overflow: hidden;
    border-width: 4px;
    align-items: center;
    justify-content: center;
    background-color: white;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.picker-icon-container:active {
    scale: 0.95 0.95;
}

.picker-icon-selected {
    border-color: rgb(255, 215, 0);
}

.picker-icon-unselected {
    border-color: rgb(209, 209, 217);
}

.picker-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.picker-btn-row {
    flex-direction: row;
    justify-content: center;
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
}

/* --- Toast notification --- */
.toast {
    position: absolute;
    bottom: 200px;
    align-self: center;
    width: 700px;
    height: 100px;
    background-color: white;
    border-radius: 50px;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.toast-shadow {
    position: absolute;
    left: -20px;
    right: -20px;
    top: -16px;
    bottom: -24px;
    border-radius: 70px;
    background-color: rgba(0, 0, 0, 0.18);
}

.toast-text {
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(115, 115, 128);
}

/* --- Cutscene --- */
.cutscene-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    transition-property: background-color, opacity;
    transition-duration: 0.6s;
}

.cutscene-panel-visible {
    background-color: rgba(0, 0, 0, 0.92);
}

.cutscene-text {
    font-size: 38px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 900px;
    height: 120px;
    position: absolute;
    left: 50%;
    translate: -600px 0;
    transition-property: translate;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

.cutscene-text-visible {
    translate: -50% 0;
}
