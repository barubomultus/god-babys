/* ======================================== */
/* TitleStyle.uss — TitleScene (flexbox)    */
/* ======================================== */

/* --- 全体レイアウト (縦並び) --- */
.title-root {
    flex-grow: 1;
    flex-direction: column;
}

/* --- 上部: devリセットボタン行 --- */
.title-top-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: flex-end;
    padding-right: 10px;
}

.dev-reset-btn {
    width: 180px;
    height: 40px;
    background-color: rgba(77, 77, 77, 0.6);
    border-radius: 4px;
    border-width: 0;
    font-size: 16px;
    color: rgb(255, 102, 102);
    -unity-text-align: middle-center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.dev-reset-btn:active {
    scale: 0.95 0.95;
}

/* --- 中央: ロゴ + ボタン群 (伸縮して残りを埋める) --- */
.title-center {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

/* --- ロゴ --- */
.title-logo {
    width: 1040px;
    height: 498px;
    align-self: center;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* --- ボタン群 (ロゴの下) --- */
.title-buttons {
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 40px;
}

.title-btn-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

/* --- 下部: 言語ボタン行 --- */
.lang-panel {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-bottom: 40px;
    padding-top: 16px;
}

.lang-btn {
    width: 90px;
    height: 36px;
    border-radius: 6px;
    margin-left: 7px;
    margin-right: 7px;
    border-width: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.lang-btn:active {
    scale: 0.95 0.95;
}

.lang-btn-active {
    background-color: rgb(77, 128, 204);
    color: white;
}

.lang-btn-inactive {
    background-color: rgb(64, 64, 77);
    color: rgb(153, 153, 153);
}

/* --- Save data list panel (モーダル) --- */
.save-panel-overlay {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.save-panel {
    width: 800px;
    height: 450px;
    background-color: #ffffff;
    border-radius: 36px;
    flex-direction: column;
    align-self: center;
    padding-top: 10px;
}

.save-panel-title {
    flex-shrink: 0;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: white;
    height: 50px;
}

.save-panel-slots {
    flex-grow: 1;
    flex-direction: column;
    align-self: center;
}

.slot-row {
    width: 460px;
    height: 60px;
    margin: 16px;
    flex-direction: row;
    padding: 16px;
    border-radius: 4px;
}

.slot-row-exists {
    background-color: rgb(51, 64, 89);
}

.slot-row-empty {
    background-color: rgb(38, 38, 51);
}

.slot-info {
    flex-grow: 1;
    font-size: 20px;
    color: white;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.slot-load-btn {
    width: 70px;
    height: 40px;
    align-self: center;
    background-color: rgb(77, 153, 102);
    border-radius: 4px;
    border-width: 0;
    font-size: 18px;
    color: white;
    -unity-text-align: middle-center;
    margin-right: 8px;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.slot-load-btn:active {
    scale: 0.95 0.95;
}

.slot-del-btn {
    width: 40px;
    height: 40px;
    align-self: center;
    background-color: rgb(179, 77, 77);
    border-radius: 4px;
    border-width: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.slot-del-btn:active {
    scale: 0.95 0.95;
}

.save-panel-close-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    padding-top: 10px;
    padding-bottom: 10px;
}

.close-btn-gray {
    width: 150px;
    height: 45px;
    background-color: rgb(128, 128, 128);
    border-radius: 4px;
    border-width: 0;
    font-size: 22px;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.close-btn-gray:active {
    scale: 0.95 0.95;
}

/* --- Confirm delete dialog --- */
.confirm-panel {
    width: 350px;
    height: 150px;
    align-self: center;
    background-color: rgba(38, 26, 26, 0.98);
    border-radius: 8px;
    flex-direction: column;
    justify-content: center;
    padding: 10px;
}

.confirm-msg {
    flex-shrink: 0;
    font-size: 22px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 15px;
}

.confirm-btn-row {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
}

.confirm-yes {
    width: 90px;
    height: 40px;
    background-color: rgb(179, 77, 77);
    border-radius: 4px;
    border-width: 0;
    font-size: 20px;
    color: white;
    -unity-text-align: middle-center;
    margin-right: 15px;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.confirm-yes:active {
    scale: 0.95 0.95;
}

.confirm-no {
    width: 90px;
    height: 40px;
    background-color: rgb(102, 102, 128);
    border-radius: 4px;
    border-width: 0;
    font-size: 20px;
    color: white;
    -unity-text-align: middle-center;
    margin-left: 15px;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.confirm-no:active {
    scale: 0.95 0.95;
}

/* --- Intro panel (全画面オーバーレイ) --- */
.intro-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.5s;
}

.intro-panel-visible {
    background-color: rgba(0, 0, 0, 0.9);
}

/* イントロテキストのコンテナ (flexbox縦並び中央揃え) */
.intro-texts {
    flex-direction: column;
    justify-content: center;
    padding-left: 10%;
    padding-right: 10%;
}

.intro-text {
    flex-shrink: 0;
    font-size: 36px;
    color: white;
    -unity-text-align: middle-center;
    white-space: normal;
    width: 800px;
    align-self: center;
    opacity: 0;
    translate: -800px 0;
    transition-property: translate, opacity;
    transition-duration: 1.5s;
    transition-timing-function: ease-in-out;
    margin-top: 40px;
    margin-bottom: 40px;
}

.intro-text-visible {
    translate: 0 0;
    opacity: 1;
}

.slot-empty-text {
    font-size: 20px;
    color: rgb(128, 128, 128);
    -unity-text-align: middle-left;
    flex-grow: 1;
    padding-left: 15px;
}
